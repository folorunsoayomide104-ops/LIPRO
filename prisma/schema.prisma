generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String?
  googleId           String?  @unique
  fullName           String
  matricNumber       String
  university         String
  faculty            String
  department         String
  level              String
  semester           String
  role               String   @default("STUDENT")
  avatarUrl          String?
  isEmailVerified    Boolean  @default(false)
  emailVerifyToken   String?
  subscriptionTier   String   @default("FREE")
  subscriptionExpiry DateTime?
  walletBalance      Float    @default(0)
  paystackCustomerId String?
  nvidiaApiKey       String?
  groqApiKey         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  courses           Course[]
  notes             Note[]
  examSessions      ExamSession[]
  examAnswerOverrides ExamAnswer[] @relation("ExamAnswerOverrider")
  questionsAuthored Question[]
  walletTxns        WalletTxn[]
  notifications     Notification[]
  aiConversations   AiConversation[]
  materials         Material[]
  documentChunks    DocumentChunk[]
  flashcards        Flashcard[]

  @@index([role])
  @@index([university, faculty, department])
}

model Course {
  id          String   @id @default(cuid())
  code        String
  title       String
  description String
  faculty     String
  department  String
  level       String
  semester    String
  lecturerId  String
  lecturer    User     @relation(fields: [lecturerId], references: [id])
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes        Note[]
  questions    Question[]
  examSessions ExamSession[]
  materials    Material[]
  flashcards   Flashcard[]

  @@index([lecturerId])
  @@index([faculty, department, level])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  // Optional: a note (e.g. a revision guide generated from an uploaded
  // document) isn't always tied to a formal course — SetNull rather than
  // Cascade so deleting a course never destroys a student's own notes.
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([userId])
}

model Question {
  id          String   @id @default(cuid())
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type        String
  question    String
  options     String?
  answer      String
  explanation String?
  imageUrl    String?
  points      Int      @default(1)
  sourceId    String?
  material    Material? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())

  examAnswers ExamAnswer[]

  @@index([courseId])
  @@index([authorId])
  @@index([sourceId])
  @@index([type])
  @@index([courseId, type])
  @@index([sourceId, type])
}

model Material {
  id           String   @id @default(cuid())
  userId       String
  courseId     String?
  originalName String
  mimeType     String
  sizeBytes    Int
  status       String   @default("ready")
  text         String?
  // Character offsets into `text` where each PDF page begins, so revision
  // guides can be generated per real page. Empty for non-PDF sources and for
  // materials ingested before this field existed — those fall back to
  // synthetic section splitting (see lib/revision-guide-gen.ts).
  pageOffsets  Int[]    @default([])
  createdAt    DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  course    Course?    @relation(fields: [courseId], references: [id])
  questions Question[]
  aiConversations AiConversationMaterial[]
  documentChunks DocumentChunk[]
  examSessions ExamSession[]
  flashcards Flashcard[]

  @@index([userId])
  @@index([courseId])
}

model Flashcard {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  front      String
  back       String

  // Lightweight review tracking (not full spaced-repetition scheduling —
  // the landing page copy never promised that, just "Flashcards").
  timesSeen      Int       @default(0)
  timesCorrect   Int       @default(0)
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([materialId])
}

model DocumentChunk {
  id        String   @id @default(cuid())
  materialId String
  material  Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content   String
  embedding  Unsupported("vector(1536)") // pgvector 1536-dim embeddings
  createdAt DateTime @default(now())

  @@index([materialId])
  @@index([userId])
  @@index([materialId, chunkIndex])
}

model ExamSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id])
  mode        String
  status      String    @default("in_progress") // in_progress | completed | abandoned
  score       Float?
  totalPoints Float?
  // LEGACY (schemaVersion 1 rows only): JSON-in-string. New attempts use ExamAnswer rows.
  answers     String?
  questionIds String?
  durationSec Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  materialId    String?
  material      Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  sourceTitle   String?
  deadlineAt    DateTime?
  autoSubmitted Boolean   @default(false)
  gradingStatus String    @default("none") // none | pending | grading | complete | degraded | failed
  gradedAt      DateTime?
  aiFeedback    String?
  lastSeenAt    DateTime?
  schemaVersion Int       @default(2) // 1 = legacy JSON row, 2 = has ExamAnswer children

  items ExamAnswer[]

  @@index([userId])
  @@index([courseId])
  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, status])
  @@index([materialId])
}

model ExamAnswer {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    ExamSession @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String?
  question   Question?   @relation(fields: [questionId], references: [id], onDelete: SetNull)
  orderIndex Int

  // Snapshot of the question, taken when the attempt is created. Keeps the paper
  // (and the graded result) intact even if the source question is later edited or deleted.
  type          String
  prompt        String
  optionsJson   String?
  imageUrl      String?
  points        Float     @default(1)
  correctAnswer String
  explanation   String?

  response   String?
  answeredAt DateTime?

  isGraded    Boolean  @default(false)
  isCorrect   Boolean?
  awarded     Float    @default(0)
  gradeMethod String? // exact | ai | heuristic | override | ungraded
  feedback    String?
  confidence  Float?
  revealed    Boolean  @default(false) // practice mode: student used "Check answer"

  overriddenBy String?
  overrider    User?     @relation("ExamAnswerOverrider", fields: [overriddenBy], references: [id])
  overrideNote String?
  overriddenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, orderIndex])
  @@index([attemptId])
  @@index([questionId])
}

model WalletTxn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  amount    Float
  reference String?  @unique
  status    String   @default("completed")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("INFO")
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String   @default("New Chat")
  messages  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials AiConversationMaterial[]

  @@index([userId])
}

model AiConversationMaterial {
  id             String        @id @default(cuid())
  conversationId String
  materialId     String
  createdAt      DateTime      @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  material       Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([conversationId, materialId])
  @@index([conversationId])
  @@index([materialId])
}

// Shared rate-limit counter, backed by Postgres rather than in-memory state
// because Vercel serverless functions don't share memory across instances —
// an in-process Map would reset per cold start and be invisible to sibling
// instances handling concurrent requests, making it useless as a limiter.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
