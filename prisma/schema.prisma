generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  fullName           String
  matricNumber       String
  university         String
  faculty            String
  department         String
  level              String
  semester           String
  role               String   @default("STUDENT")
  avatarUrl          String?
  isEmailVerified    Boolean  @default(false)
  emailVerifyToken   String?
  subscriptionTier   String   @default("FREE")
  subscriptionExpiry DateTime?
  walletBalance      Float    @default(0)
  paystackCustomerId String?
  nvidiaApiKey       String?
  groqApiKey         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  courses           Course[]
  notes             Note[]
  examSessions      ExamSession[]
  questionsAuthored Question[]
  walletTxns        WalletTxn[]
  notifications     Notification[]
  aiConversations   AiConversation[]
  materials         Material[]

  @@index([role])
  @@index([university, faculty, department])
}

model Course {
  id          String   @id @default(cuid())
  code        String
  title       String
  description String
  faculty     String
  department  String
  level       String
  semester    String
  lecturerId  String
  lecturer    User     @relation(fields: [lecturerId], references: [id])
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes        Note[]
  questions    Question[]
  examSessions ExamSession[]
  materials    Material[]

  @@index([lecturerId])
  @@index([faculty, department, level])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([userId])
}

model Question {
  id          String   @id @default(cuid())
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type        String
  question    String
  options     String?
  answer      String
  explanation String?
  imageUrl    String?
  points      Int      @default(1)
  sourceId    String?
  material    Material? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([courseId])
  @@index([authorId])
  @@index([sourceId])
}

model Material {
  id           String   @id @default(cuid())
  userId       String
  courseId     String?
  originalName String
  mimeType     String
  sizeBytes    Int
  status       String   @default("ready")
  text         String?
  createdAt    DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id])
  course    Course?    @relation(fields: [courseId], references: [id])
  questions Question[]
  aiConversations AiConversationMaterial[]

  @@index([userId])
  @@index([courseId])
}

model ExamSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id])
  mode        String
  status      String    @default("in_progress")
  score       Float?
  totalPoints Float?
  answers     String?
  questionIds String?
  durationSec Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([courseId])
}

model WalletTxn {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  amount    Float
  reference String?
  status    String   @default("completed")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("INFO")
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String   @default("New Chat")
  messages  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials AiConversationMaterial[]

  @@index([userId])
}

model AiConversationMaterial {
  id             String        @id @default(cuid())
  conversationId String
  materialId     String
  createdAt      DateTime      @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  material       Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([conversationId, materialId])
  @@index([conversationId])
  @@index([materialId])
}
