# Database - SQLite (local development)
# For production, switch provider in prisma/schema.prisma and use a hosted Postgres URL.
DATABASE_URL="file:./dev.db"

# Auth - JWT signing secret (REQUIRED: change before production)
JWT_SECRET="replace-with-a-long-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Vercel Blob (large file uploads up to 100MB)
# REQUIRED in production + local dev for PDF/CBT uploads to work.
# Create a Blob store in the Vercel dashboard (Storage -> Blob) and copy
# the "BLOB_READ_WRITE_TOKEN" into your project env / .env.
BLOB_READ_WRITE_TOKEN=""

# AI (LIPRO AI) - NVIDIA NIM. Get a free key at https://build.nvidia.com
# Leave NVIDIA_API_KEY empty to run in demo mode (sample responses).
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# Optional: Groq (used if set, takes priority over NVIDIA)
# GROQ_API_KEY=""
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# GROQ_MODEL="llama-3.3-70b-versatile"

# Payments (optional, for Premium/Ultimate billing) - add later
# PAYSTACK_SECRET_KEY="sk_live_..."
# PAYSTACK_PUBLIC_KEY="pk_live_..."

# ---------------------------------------------------------------------------
# PRODUCTION (self-hosted Node server / Docker)
# The 4.5MB Vercel serverless body limit does NOT exist here:
# Node reads the full body, so uploads up to MAX_UPLOAD_BYTES (100MB) work.
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://user:pass@host:5432/lipro"
# JWT_SECRET="generate-a-long-random-string"
# NEXT_PUBLIC_APP_URL="https://your-domain.com"
# NODE_ENV="production"

