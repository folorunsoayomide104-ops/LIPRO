# Database - SQLite (local development)
# For production, switch provider in prisma/schema.prisma and use a hosted Postgres URL.
DATABASE_URL="file:./dev.db"

# Auth - JWT signing secret (REQUIRED: change before production)
JWT_SECRET="replace-with-a-long-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Password reset is handled entirely through Google Sign-In (see
# GOOGLE_CLIENT_ID/SECRET below) rather than an emailed link — there is no
# outbound-email dependency for this app to configure.

# Vercel Blob (large file uploads up to 100MB)
# REQUIRED in production + local dev for PDF/CBT uploads to work.
# Create a Blob store in the Vercel dashboard (Storage -> Blob) and copy
# the "BLOB_READ_WRITE_TOKEN" into your project env / .env.
BLOB_READ_WRITE_TOKEN=""

# AI (LIPRO AI) - NVIDIA NIM only. Get a free key at https://build.nvidia.com
# This is a fallback for users who haven't added their own key in Settings —
# each user's personal nvidiaApiKey (stored on their account) is always
# checked first, so usage is isolated per student rather than shared across
# everyone against one key. Leave NVIDIA_API_KEY empty to run in demo mode
# for anyone without a personal key.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"
# Comma-separated model failover chain for CBT question generation — see
# lib/ai.ts's NVIDIA_MODEL_CHAIN for the default and why it exists.
# NVIDIA_MODEL_CHAIN="nvidia/llama-3.1-nemotron-70b-instruct,nvidia/nemotron-3.5-lightning-30b-a3b"

# Payments (optional, for Premium/Ultimate billing) - add later
# PAYSTACK_SECRET_KEY="sk_live_..."
# PAYSTACK_PUBLIC_KEY="pk_live_..."

# Google Sign-In. Without these, both the "Log in with Google" button and
# forgot-password redirect back with a friendly "not set up yet" message
# instead of erroring — email/password *login* still works either way, but
# forgot-password has no other route to a working reset without this set.
# Create credentials at https://console.cloud.google.com/apis/credentials
# ("OAuth client ID" -> Web application), and add this exact redirect URI:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# PRODUCTION (self-hosted Node server / Docker)
# The 4.5MB Vercel serverless body limit does NOT exist here:
# Node reads the full body, so uploads up to MAX_UPLOAD_BYTES (100MB) work.
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://user:pass@host:5432/lipro"
# JWT_SECRET="generate-a-long-random-string"
# NEXT_PUBLIC_APP_URL="https://your-domain.com"
# NODE_ENV="production"

